{
  "functions": {
    "api/[...slug].js": {
      "includeFiles": "src/**"
    }
  },
  "rewrites": [
    { "source": "/api", "destination": "/api/[...slug]" },
    { "source": "/api/(.*)", "destination": "/api/[...slug]" },
    { "source": "/((?!api/|css/|js/|assets/|favicon.ico|.*\\..*).*)", "destination": "/index.html" }
  ]
}
