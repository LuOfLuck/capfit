rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Funciones Auxiliares de Autenticación y Validación
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
        request.auth.token.email == 'lucasg33322@gmail.com';
    }

    function isStoreOwner(storeId) {
      return isSuperAdmin() ||
        (isAuthenticated() && request.auth.token.storeId == storeId);
    }

    // Garantiza que ningún documento público de tienda contenga credenciales
    function hasNoExposedCredentials(data) {
      return !('adminUsername' in data) && !('adminPassword' in data);
    }

    // Inmutabilidad de campos financieros y de cuota para no-SuperAdmins
    function quotaFieldsUnchanged() {
      return request.resource.data.plan == resource.data.plan &&
        request.resource.data.aiMonthlyLimit == resource.data.aiMonthlyLimit &&
        request.resource.data.aiGenerationsUsed == resource.data.aiGenerationsUsed &&
        request.resource.data.aiPeriod == resource.data.aiPeriod;
    }

    // =========================================================================
    // 1. Colección Pública de Tiendas: stores/{storeId}
    // =========================================================================
    match /stores/{storeId} {
      // Lectura pública segura: este documento ya NO contiene adminUsername ni adminPassword
      allow read: if true;

      // Creación de tiendas: solo SuperAdmin y sin credenciales en el documento público
      allow create: if isSuperAdmin() &&
        hasNoExposedCredentials(request.resource.data) &&
        request.resource.data.name is string &&
        request.resource.data.subdomain is string &&
        request.resource.data.aiMonthlyLimit is number &&
        request.resource.data.aiMonthlyLimit >= 0 &&
        request.resource.data.aiGenerationsUsed is number &&
        request.resource.data.aiGenerationsUsed >= 0 &&
        request.resource.data.active is bool;

      // Actualización: SuperAdmin puede editar todo (sin inyectar credenciales en stores);
      // el dueño de la tienda solo puede editar metadatos de marca (name, tagline, about) sin tocar cuotas
      allow update: if hasNoExposedCredentials(request.resource.data) && (
        isSuperAdmin() ||
        (isStoreOwner(storeId) && quotaFieldsUnchanged())
      );

      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 2. Colección Privada de Secretos de Tienda: store_secrets/{storeId}
    // =========================================================================
    match /store_secrets/{storeId} {
      // BLOQUEADO al público: ningún comprador ni script anónimo en el navegador puede leerlo.
      // Solo accesible desde el backend (server.js / api/serverless.js) o por el SuperAdmin autenticado.
      allow read, write: if isSuperAdmin();
    }

    // =========================================================================
    // 3. Colección de Productos: products/{productId}
    // =========================================================================
    match /products/{productId} {
      allow read: if true;

      allow create: if isStoreOwner(request.resource.data.storeId) &&
        request.resource.data.storeId is string &&
        request.resource.data.name is string &&
        request.resource.data.price is number &&
        request.resource.data.price >= 0 &&
        request.resource.data.stock is number &&
        request.resource.data.stock >= 0;

      allow update: if isStoreOwner(resource.data.storeId) &&
        request.resource.data.storeId == resource.data.storeId &&
        request.resource.data.price is number &&
        request.resource.data.price >= 0 &&
        request.resource.data.stock is number &&
        request.resource.data.stock >= 0;

      allow delete: if isStoreOwner(resource.data.storeId);
    }

    // =========================================================================
    // 4. Colección de Órdenes: orders/{orderId}
    // =========================================================================
    match /orders/{orderId} {
      // Solo el dueño de la tienda o el SuperAdmin pueden leer y actualizar el listado de órdenes
      allow read: if isStoreOwner(resource.data.storeId);

      // Compradores pueden crear órdenes únicamente en estado 'pending' y con monto positivo
      allow create: if request.resource.data.storeId is string &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.totalAmount is number &&
        request.resource.data.totalAmount > 0 &&
        request.resource.data.status == 'pending';

      // El estado de la orden solo puede ser modificado por el administrador de la tienda o SuperAdmin
      allow update: if isStoreOwner(resource.data.storeId) &&
        request.resource.data.storeId == resource.data.storeId &&
        request.resource.data.totalAmount == resource.data.totalAmount;

      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 5. Colección de Analíticas: analytics_events/{eventId}
    // =========================================================================
    match /analytics_events/{eventId} {
      allow read: if isStoreOwner(resource.data.storeId);

      allow create: if request.resource.data.storeId is string &&
        request.resource.data.type is string;

      allow update, delete: if isSuperAdmin();
    }
  }
}