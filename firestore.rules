rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // ============================================================================
    // CAPFIT Multi-Tenant Security Rules
    // Protects against all 12 Dirty Dozen payloads from security_spec.md:
    //
    // - Payload 1 (Ghost Field Injection): Blocked by isValidProduct/isValidStore type checks.
    // - Payload 2 (Cross-Tenant Poisoning): Blocked by isStoreOwner() verifying store_owners/{uid}.
    // - Payload 3 (Oversized ID DoW Attack): Blocked by isValidId() enforcing size <= 128 and charset.
    // - Payload 4 (Negative Stock Attack): Blocked by isValidProduct() enforcing stock >= 0.
    // - Payload 5 (Negative Price Exploit): Blocked by isValidProduct() enforcing precio >= 0.
    // - Payload 6 (Quota Hack): Blocked by diff().affectedKeys().hasAny(['aiGenerationsUsed',...]).
    // - Payload 7 (Blanket List Scraping): Blocked by list queries checking resource.data.storeId.
    // - Payload 8 (Immortal Field Mutation): Blocked by incoming().id == existing().id etc.
    // - Payload 9 (Terminal State Reversal): Blocked by !existing().status.matches('^(entregado|cancelado)$').
    // - Payload 10 (Type Poisoning): Blocked by explicit type guards (is number, is string, is list).
    // - Payload 11 (Empty/Missing Tenant Key): Blocked by data.storeId is string && isValidId(data.storeId).
    // - Payload 12 (Unstructured Injection): Blocked by shape validators isValidOrder and isValidProduct.
    //
    // To set admin custom claims on a user, run:
    //   node scripts/set-admin-claim.js <uid-or-email>
    // ============================================================================

    // ── Helper Functions ───────────────────────────────────────────────────────
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-#]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // SuperAdmin check via Firebase Auth Custom Claims (NEVER hardcoded email)
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Store Owner verification: Admin OR authenticated user whose store_owners document matches storeId
    function isStoreOwner(sId) {
      return isSignedIn() && (
        isAdmin() || (
          exists(/databases/$(database)/documents/store_owners/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/store_owners/$(request.auth.uid)).data.storeId == sId
        )
      );
    }

    function isValidStore(data) {
      return data.id is string && isValidId(data.id) &&
             data.subdomain is string && data.subdomain.size() > 0 && data.subdomain.size() <= 64 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (!('aiMonthlyLimit' in data) || data.aiMonthlyLimit is number) &&
             (!('aiGenerationsUsed' in data) || data.aiGenerationsUsed is number);
    }

    function isValidProduct(data) {
      return data.id is string && isValidId(data.id) &&
             data.storeId is string && isValidId(data.storeId) &&
             data.nombre is string && data.nombre.size() > 0 && data.nombre.size() <= 120 &&
             data.precio is number && data.precio >= 0 &&
             (!('stock' in data) || (data.stock is number && data.stock >= 0));
    }

    function isValidOrder(data) {
      return data.id is string && isValidId(data.id) &&
             data.storeId is string && isValidId(data.storeId) &&
             data.total is number && data.total >= 0 &&
             data.items is list &&
             data.status is string && data.status.size() <= 40;
    }

    function isValidStoreOwner(data) {
      return data.uid is string && isValidId(data.uid) &&
             data.storeId is string && isValidId(data.storeId) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 128));
    }

    function isValidAiLog(data) {
      return data.storeId is string && isValidId(data.storeId);
    }

    // ── Stores Collection ──────────────────────────────────────────────────────
    // Public read for subdomain resolution and multi-tenant storefronts.
    // Critical: Owners cannot tamper with billing, AI quota or plan fields!
    match /stores/{storeId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(storeId) && isValidStore(incoming());
      allow update: if isValidId(storeId) &&
                       (isStoreOwner(storeId) || isAdmin()) &&
                       isValidStore(incoming()) &&
                       (!incoming().diff(existing()).affectedKeys().hasAny(['aiGenerationsUsed', 'aiMonthlyLimit', 'plan', 'isActive']));
      allow delete: if isAdmin();

      // Nested products under /stores/{storeId}/products/{productId}
      match /products/{productId} {
        allow get, list: if true;
        allow create: if isValidId(productId) &&
                         isStoreOwner(storeId) &&
                         isValidProduct(incoming()) &&
                         incoming().storeId == storeId;
        allow update: if isValidId(productId) &&
                         isStoreOwner(storeId) &&
                         isValidProduct(incoming()) &&
                         incoming().id == existing().id &&
                         incoming().storeId == existing().storeId &&
                         (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt);
        allow delete: if isValidId(productId) && isStoreOwner(storeId);
      }
    }

    // ── Root Products Collection ───────────────────────────────────────────────
    // Public catalog reads. Writes strictly restricted to verified store owners.
    match /products/{productId} {
      allow get, list: if true;
      allow create: if isValidId(productId) &&
                       isStoreOwner(incoming().storeId) &&
                       isValidProduct(incoming()) &&
                       incoming().id == productId;
      allow update: if isValidId(productId) &&
                       isStoreOwner(existing().storeId) &&
                       isValidProduct(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().storeId == existing().storeId &&
                       (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt);
      allow delete: if isValidId(productId) && isStoreOwner(existing().storeId);
    }

    // ── Orders Collection ──────────────────────────────────────────────────────
    // Anonymous public creation (customers purchasing without account).
    // Read and list strictly scoped to store owners and admins.
    // Updates forbid tampering with immutable fields or reversing terminal states.
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && isStoreOwner(resource.data.storeId);
      allow list: if isSignedIn() && (
        isAdmin() || (
          exists(/databases/$(database)/documents/store_owners/$(request.auth.uid)) &&
          resource.data.storeId == get(/databases/$(database)/documents/store_owners/$(request.auth.uid)).data.storeId
        )
      );
      allow create: if isValidId(orderId) &&
                       isValidOrder(incoming()) &&
                       incoming().id == orderId;
      allow update: if isValidId(orderId) &&
                       isStoreOwner(existing().storeId) &&
                       isValidOrder(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().storeId == existing().storeId &&
                       (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) &&
                       (!existing().status.matches('^(entregado|cancelado)$'));
      allow delete: if isAdmin();
    }

    // ── AI Logs Collection ─────────────────────────────────────────────────────
    // Logging generation requests. Strictly immutable (no updates or deletes).
    match /ai_logs/{logId} {
      allow create: if isValidId(logId) && isValidAiLog(incoming());
      allow get, list: if isSignedIn() && (
        isAdmin() || (
          exists(/databases/$(database)/documents/store_owners/$(request.auth.uid)) &&
          resource.data.storeId == get(/databases/$(database)/documents/store_owners/$(request.auth.uid)).data.storeId
        )
      );
      allow update, delete: if false;
    }

    // ── Store Owners Collection ────────────────────────────────────────────────
    // Role/tenant mapping for authenticated users.
    match /store_owners/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn() &&
                               request.auth.uid == userId &&
                               incoming().uid == request.auth.uid &&
                               isValidStoreOwner(incoming());
      allow delete: if isAdmin();
    }
  }
}
