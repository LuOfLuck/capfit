rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Funciones Auxiliares de Autenticación y Validación
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
        request.auth.token.email == 'lucasg33322@gmail.com';
    }

    // Reconocimiento de Dueño de Tienda (Opción A):
    // 1. SuperAdmin
    // 2. Custom Claim de Firebase Auth (storeId)
    // 3. Documento Global de Usuario users/{uid} con storeId en su array 'ownedStores'
    function isStoreOwner(storeId) {
      return isSuperAdmin() ||
        (isAuthenticated() && (
          request.auth.token.storeId == storeId ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           storeId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('ownedStores', []))
        ));
    }

    // Garantiza que ningún documento público de tienda contenga credenciales
    function hasNoExposedCredentials(data) {
      return !('adminUsername' in data) && !('adminPassword' in data);
    }

    // Inmutabilidad de campos financieros y de cuota para no-SuperAdmins
    function quotaFieldsUnchanged() {
      return request.resource.data.plan == resource.data.plan &&
        request.resource.data.aiMonthlyLimit == resource.data.aiMonthlyLimit &&
        request.resource.data.aiGenerationsUsed == resource.data.aiGenerationsUsed &&
        request.resource.data.aiPeriod == resource.data.aiPeriod;
    }

    // =========================================================================
    // 1. Colección Privada de Secretos de Tienda: store_secrets/{storeId}
    // =========================================================================
    match /store_secrets/{storeId} {
      // BLOQUEADO al público: ningún comprador ni script anónimo en el navegador puede leerlo.
      // Solo accesible desde el backend o por el SuperAdmin autenticado.
      allow read, write: if isSuperAdmin();
    }

    // =========================================================================
    // 2. Colección Pública de Tiendas: stores/{storeId}
    // =========================================================================
    match /stores/{storeId} {
      allow read: if true;

      allow create: if isSuperAdmin() &&
        hasNoExposedCredentials(request.resource.data) &&
        request.resource.data.name is string &&
        request.resource.data.subdomain is string;

      allow update: if hasNoExposedCredentials(request.resource.data) && (
        isSuperAdmin() ||
        (isStoreOwner(storeId) && quotaFieldsUnchanged())
      );

      allow delete: if isSuperAdmin();

      match /products/{productId} {
        allow read: if true;
        allow write: if isStoreOwner(storeId);
      }
    }

    // =========================================================================
    // 3. Colección de Productos Particionada: products/{productId}
    // =========================================================================
    match /products/{productId} {
      allow read: if true;
      allow write: if isStoreOwner(resource.data.storeId) || isStoreOwner(request.resource.data.storeId);
    }

    // =========================================================================
    // 4. Colección Global de Usuarios (CapFit ID): users/{uid}
    // =========================================================================
    match /users/{uid} {
      // El comprador solo puede leer y actualizar su propio perfil
      allow read: if isSelf(uid) || isSuperAdmin();
      // El cliente NUNCA puede asignarse a sí mismo 'ownedStores'; solo el backend lo otorga
      allow create: if isSelf(uid) && !('ownedStores' in request.resource.data);
      allow update: if (isSelf(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownedStores'])) || isSuperAdmin();
      allow delete: if isSelf(uid) || isSuperAdmin();
    }

    // =========================================================================
    // 5. Relación Cliente-Tienda: store_customers/{relationId} (${storeId}_${uid})
    // =========================================================================
    match /store_customers/{relationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isStoreOwner(resource.data.storeId));
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 6. Historial de Generaciones IA: try_on_generations/{genId}
    // =========================================================================
    match /try_on_generations/{genId} {
      // Lectura para el propio usuario o el dueño de la tienda
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isStoreOwner(resource.data.storeId));
      // Inmutable desde el cliente: solo generado por el backend de probador virtual
      allow write: if false;
    }

    // =========================================================================
    // 7. Colección de Órdenes: orders/{orderId}
    // =========================================================================
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isStoreOwner(resource.data.storeId));

      allow create: if request.resource.data.storeId is string &&
        request.resource.data.status == 'pending' &&
        (
          (request.resource.data.totalAmount is number && request.resource.data.totalAmount > 0) ||
          (request.resource.data.total is number && request.resource.data.total > 0)
        );

      allow update: if isStoreOwner(resource.data.storeId);
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 8. Colección de Analíticas: analytics_events/{eventId}
    // =========================================================================
    match /analytics_events/{eventId} {
      allow read: if isStoreOwner(resource.data.storeId);
      allow create: if request.resource.data.storeId is string;
      allow update, delete: if isSuperAdmin();
    }

    // =========================================================================
    // 9. Colección de Logs IA: ai_logs/{logId}
    // =========================================================================
    match /ai_logs/{logId} {
      allow read: if isStoreOwner(resource.data.storeId);
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    // =========================================================================
    // 10. Dueños de Tienda: store_owners/{ownerId}
    // =========================================================================
    match /store_owners/{ownerId} {
      allow read: if isAuthenticated() && (request.auth.uid == ownerId || isSuperAdmin());
      allow write: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == ownerId);
    }
  }
}