rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Funciones Auxiliares de Autenticación y Validación
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
        request.auth.token.email == 'lucasg33322@gmail.com';
    }

    // Reconocimiento de Dueño de Tienda (Opción A):
    // 1. SuperAdmin
    // 2. Custom Claim de Firebase Auth (storeId)
    // 3. Documento Global de Usuario users/{uid} con storeId en su array 'ownedStores'
    function isStoreOwner(storeId) {
      return isSuperAdmin() ||
        (isAuthenticated() && (
          request.auth.token.storeId == storeId ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           storeId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('ownedStores', []))
        ));
    }

    // Garantiza que ningún documento público de tienda contenga credenciales
    function hasNoExposedCredentials(data) {
      return !('adminUsername' in data) && !('adminPassword' in data);
    }

    // Inmutabilidad de campos financieros y de cuota para no-SuperAdmins
    function quotaFieldsUnchanged() {
      return request.resource.data.plan == resource.data.plan &&
        request.resource.data.aiMonthlyLimit == resource.data.aiMonthlyLimit &&
        request.resource.data.aiGenerationsUsed == resource.data.aiGenerationsUsed &&
        request.resource.data.aiPeriod == resource.data.aiPeriod;
    }

    // =========================================================================
    // 1. Colección Privada de Secretos de Tienda: store_secrets/{storeId}
    // =========================================================================
    match /store_secrets/{storeId} {
      // Las credenciales en store_secrets se almacenan hasheadas (scrypt_v1) y cifradas (AES-256-GCM enc_v1).
      // Accesible por el backend Node.js (request.auth == null) y por SuperAdmin.
      allow read, write: if isSuperAdmin() || request.auth == null;
    }

    // =========================================================================
    // 2. Colección Pública de Tiendas: stores/{storeId}
    // =========================================================================
    match /stores/{storeId} {
      allow read: if true;

      allow create: if hasNoExposedCredentials(request.resource.data) &&
        request.resource.data.name is string &&
        request.resource.data.subdomain is string && (
          isSuperAdmin() ||
          request.auth == null ||
          (isAuthenticated() && request.resource.data.ownerUid == request.auth.uid)
        );

      allow update: if hasNoExposedCredentials(request.resource.data) && (
        isSuperAdmin() ||
        request.auth == null ||
        (isStoreOwner(storeId) && quotaFieldsUnchanged()) ||
        (isAuthenticated() && resource.data.ownerUid == request.auth.uid && quotaFieldsUnchanged())
      );

      allow delete: if isSuperAdmin() || request.auth == null;

      match /products/{productId} {
        allow read: if true;
        allow write: if isStoreOwner(storeId) || request.auth == null;
      }
    }

    // =========================================================================
    // 3. Colección de Productos Particionada: products/{productId}
    // =========================================================================
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth == null ||
        (resource != null && isStoreOwner(resource.data.storeId)) ||
        (request.resource != null && isStoreOwner(request.resource.data.storeId));
    }

    // =========================================================================
    // 4. Colección Global de Usuarios (CapFit ID): users/{uid}
    // =========================================================================
    match /users/{uid} {
      allow read: if isSelf(uid) || isSuperAdmin() || request.auth == null;
      allow create: if (isSelf(uid) && !('ownedStores' in request.resource.data)) || isSuperAdmin() || request.auth == null;
      allow update: if (isSelf(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownedStores'])) || isSuperAdmin() || request.auth == null;
      allow delete: if isSelf(uid) || isSuperAdmin() || request.auth == null;
    }

    // =========================================================================
    // 5. Relación Cliente-Tienda: store_customers/{relationId} (${storeId}_${uid})
    // =========================================================================
    match /store_customers/{relationId} {
      allow read: if (isAuthenticated() && (resource.data.userId == request.auth.uid || isStoreOwner(resource.data.storeId))) || request.auth == null;
      allow create, update: if (isAuthenticated() && request.resource.data.userId == request.auth.uid) || request.auth == null;
      allow delete: if isSuperAdmin() || request.auth == null;
    }

    // =========================================================================
    // 6. Historial de Generaciones IA: try_on_generations/{genId}
    // =========================================================================
    match /try_on_generations/{genId} {
      allow read: if (isAuthenticated() && (resource.data.userId == request.auth.uid || isStoreOwner(resource.data.storeId))) || request.auth == null;
      allow write: if request.auth == null;
    }

    // =========================================================================
    // 7. Colección de Órdenes: orders/{orderId}
    // =========================================================================
    match /orders/{orderId} {
      allow read: if (isAuthenticated() && (resource.data.userId == request.auth.uid || isStoreOwner(resource.data.storeId))) || request.auth == null;

      allow create: if request.resource.data.storeId is string && (
        request.auth == null ||
        (
          request.resource.data.status == 'pending' &&
          (
            (request.resource.data.totalAmount is number && request.resource.data.totalAmount > 0) ||
            (request.resource.data.total is number && request.resource.data.total > 0)
          )
        )
      );

      allow update: if request.auth == null || isStoreOwner(resource.data.storeId);
      allow delete: if isSuperAdmin() || request.auth == null;
    }

    // =========================================================================
    // 8. Colección de Analíticas: analytics_events/{eventId}
    // =========================================================================
    match /analytics_events/{eventId} {
      allow read: if request.auth == null || isStoreOwner(resource.data.storeId);
      allow create: if request.resource.data.storeId is string;
      allow update, delete: if isSuperAdmin() || request.auth == null;
    }

    // =========================================================================
    // 9. Colección de Logs IA: ai_logs/{logId}
    // =========================================================================
    match /ai_logs/{logId} {
      allow read: if request.auth == null || isStoreOwner(resource.data.storeId);
      allow create: if true;
      allow update, delete: if isSuperAdmin() || request.auth == null;
    }

    // =========================================================================
    // 10. Dueños de Tienda: store_owners/{ownerId}
    // =========================================================================
    match /store_owners/{ownerId} {
      allow read: if request.auth == null || (isAuthenticated() && (request.auth.uid == ownerId || isSuperAdmin()));
      allow write: if request.auth == null || isSuperAdmin() || (isAuthenticated() && request.auth.uid == ownerId);
    }
  }
}