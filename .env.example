# ==============================================================================
# CAPFIT — Variables de Entorno
# Copiá este archivo como .env y completá con tus claves reales.
# ==============================================================================

# Clave de API de fal.ai (requerida para Virtual Try-On FASHN y GPT-Image-2.5 Flare / GPT-Image-2)
# Modelo activo: openai/gpt-image-2.5/flare/edit (fallback: openai/gpt-image-2/edit)
# Obtenela en https://fal.ai/dashboard/keys
FAL_KEY=

# Clave de API de Anthropic (opcional si usás el asistente/copywriter)
# Obtenela en https://console.anthropic.com/
ANTHROPIC_KEY=

# Contraseña maestra para el panel de SuperAdmin de la plataforma
ADMIN_PASSWORD=capfit2026

# Email de SuperAdmin para asignación de Custom Claims en Firebase Auth
SUPERADMIN_EMAIL=lucasg33322@gmail.com

# Orígenes CORS permitidos (separados por coma, sin barra al final)
ALLOWED_ORIGINS=https://capfit.store,https://www.capfit.store,http://localhost:3000,http://127.0.0.1:3000

# Puerto local para server.js
PORT=3000

# Entorno de ejecución (development | production)
NODE_ENV=development
