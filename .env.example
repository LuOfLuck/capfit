# ==============================================================================
# CAPFIT - Variables de Entorno
# ==============================================================================

# 1. fal.ai API key (REQUERIDA para Probador Virtual con IA)
# Modelo principal: openai/gpt-image-2.5/sunburst/edit
# Modelo fallback:  openai/gpt-image-2/edit
# Modelo secundario: fal-ai/fashn/tryon/v1.5
FAL_KEY=

# 2. Anthropic API key (Opcional - para asistentes y sugerencias inteligentes)
ANTHROPIC_KEY=

# 3. Orígenes CORS Permitidos (separados por coma, o * para permitir todos)
# Recomendado en producción: https://capfit.store,https://admin.capfit.store,http://localhost:3000
ALLOWED_ORIGINS=https://capfit.store,https://admin.capfit.store,http://localhost:3000

# 4. Contraseña maestra del SuperAdmin para backoffice y administración global
ADMIN_PASSWORD=capfit2026

# 5. Email de SuperAdmin con acceso global a todos los tenants y estadísticas
SUPERADMIN_EMAIL=lucasg33322@gmail.com

# 6. Puerto del servidor Node.js (default: 3000)
PORT=3000

# 7. Mercado Pago (Débito Automático Recurrente / Suscripciones Preapproval)
# Credencial de producción (APP_USR-...) o de prueba (TEST-...)
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
# Secret para validación de firmas HMAC de Webhooks de Mercado Pago
MERCADO_PAGO_WEBHOOK_SECRET=
