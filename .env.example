# ==============================================================================
# CAPFIT - Variables de Entorno
# ==============================================================================

# 1. fal.ai API key (REQUERIDA para Probador Virtual con IA)
# Modelo principal: openai/gpt-image-2.5/sunburst/edit
# Modelo fallback:  openai/gpt-image-2/edit
# Modelo secundario: fal-ai/fashn/tryon/v1.5
FAL_KEY=

# 2. Anthropic API key (Opcional - para asistentes y sugerencias inteligentes)
ANTHROPIC_KEY=

# 3. Orígenes CORS Permitidos (separados por coma, o * para permitir todos)
# Recomendado en producción: https://capfit.store,https://admin.capfit.store,http://localhost:3000
ALLOWED_ORIGINS=https://capfit.store,https://admin.capfit.store,http://localhost:3000

# 4. Contraseña maestra del SuperAdmin para backoffice y administración global (requerido para login por clave maestra)
ADMIN_PASSWORD=

# 5. Clave secreta para firmar sesiones administrativas con HMAC-SHA256 (mínimo 32 caracteres)
SESSION_SECRET=

# 6. Proyecto Firebase unificado (Cliente y Servidor)
FIREBASE_PROJECT_ID=capfit-6689b

# 7. Email de SuperAdmin con acceso global a todos los tenants y estadísticas
SUPERADMIN_EMAIL=lucasg33322@gmail.com

# 8. Puerto del servidor Node.js (default: 3000)
PORT=3000

# 9. Mercado Pago (Débito Automático Recurrente / Suscripciones Preapproval)
# Credencial de producción (APP_USR-...) o de prueba (TEST-...)
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
# Secret para validación de firmas HMAC de Webhooks de Mercado Pago
MERCADO_PAGO_WEBHOOK_SECRET=

# 10. Google Analytics 4 (ID de medición, ej: G-XXXXXXXXXX)
GA_MEASUREMENT_ID=

# 11. Cifrado AES-256-GCM de credenciales multi-tenant en store_secrets (mínimo 32 caracteres)
MP_TOKEN_ENCRYPTION_KEY=

# 12. Mercado Pago OAuth Multi-Tenant (para conexión de vendedores por tienda)
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=

