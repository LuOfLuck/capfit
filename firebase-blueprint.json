{
  "entities": {
    "Store": {
      "title": "Store",
      "description": "Tenant store configuration, admin credentials, and monthly AI Try-On quota",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "subdomain": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 100 },
        "tagline": { "type": "string", "maxLength": 200 },
        "about": { "type": "object" },
        "adminUsername": { "type": "string", "maxLength": 64 },
        "adminPassword": { "type": "string", "maxLength": 64 },
        "ownerEmail": { "type": "string", "maxLength": 120 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "plan": { "type": "string", "maxLength": 50 },
        "aiMonthlyLimit": { "type": "number" },
        "aiGenerationsUsed": { "type": "number" },
        "aiPeriod": { "type": "string", "maxLength": 20 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "subdomain", "name"]
    },
    "User": {
      "title": "User",
      "description": "Global CapFit ID shopper profile, head measurement fit profile, base selfies for 1-click try-on, and saved shipping addresses",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 120 },
        "displayName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 40 },
        "dni": { "type": "string", "maxLength": 30 },
        "ownedStores": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Array of storeIds owned by this user (written only by backend)"
        },
        "fitProfile": {
          "type": "object",
          "properties": {
            "headCircumferenceCm": { "type": "number" },
            "preferredStyles": { "type": "array", "items": { "type": "string" } },
            "fittedSize": { "type": "string", "maxLength": 20 }
          }
        },
        "baseSelfies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "imageUrl": { "type": "string" },
              "isDefault": { "type": "boolean" },
              "uploadedAt": { "type": "string" }
            }
          }
        },
        "addresses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "alias": { "type": "string" },
              "recipientName": { "type": "string" },
              "street": { "type": "string" },
              "number": { "type": "string" },
              "floorApt": { "type": "string" },
              "city": { "type": "string" },
              "province": { "type": "string" },
              "postalCode": { "type": "string" },
              "isDefault": { "type": "boolean" }
            }
          }
        },
        "createdAt": { "type": "string", "maxLength": 40 },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["uid", "email"]
    },
    "StoreCustomer": {
      "title": "StoreCustomer",
      "description": "Tenant relation document per store: store_customers/{storeId}_{uid}",
      "type": "object",
      "properties": {
        "storeId": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "customerSnapshot": {
          "type": "object",
          "properties": {
            "displayName": { "type": "string" },
            "email": { "type": "string" },
            "phone": { "type": "string" }
          }
        },
        "wishlistProductIds": { "type": "array", "items": { "type": "string" } },
        "marketingOptIn": { "type": "boolean" },
        "stats": {
          "type": "object",
          "properties": {
            "totalOrders": { "type": "number" },
            "totalSpent": { "type": "number" },
            "tryOnsCount": { "type": "number" },
            "firstInteractionAt": { "type": "string" },
            "lastOrderAt": { "type": "string" }
          }
        }
      },
      "required": ["storeId", "userId"]
    },
    "TryOnGeneration": {
      "title": "TryOnGeneration",
      "description": "History of virtual try-on generations for AI analytics and user history",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "storeId": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "isOwnerTest": { "type": "boolean" },
        "productId": { "type": "string", "maxLength": 64 },
        "productSnapshot": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "price": { "type": "number" },
            "thumbnailUrl": { "type": "string" }
          }
        },
        "resultImageUrl": { "type": "string" },
        "convertedToOrder": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["storeId", "resultImageUrl", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Cap (gorra), sunglasses (anteojos), hat or accessory item in a client store catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "storeId": { "type": "string", "maxLength": 64 },
        "tipo": { "type": "string", "maxLength": 40 },
        "nombre": { "type": "string", "maxLength": 120 },
        "marca": { "type": "string", "maxLength": 60 },
        "coleccion": { "type": "string", "maxLength": 60 },
        "precio": { "type": "number" },
        "precioAnterior": { "type": "number" },
        "categoria": { "type": "string", "maxLength": 60 },
        "tag": { "type": "string", "maxLength": 40 },
        "badge": { "type": "string", "maxLength": 40 },
        "stock": { "type": "number" },
        "imagen": { "type": "string", "maxLength": 500 },
        "imgPreview": { "type": "string", "maxLength": 500 },
        "imgFrontal": { "type": "string", "maxLength": 500 },
        "descripcion": { "type": "string", "maxLength": 500 },
        "color": { "type": "string", "maxLength": 60 },
        "colores": { "type": "array" },
        "esNuevo": { "type": "boolean" },
        "destacado": { "type": "boolean" },
        "rating": { "type": "number" },
        "reviews": { "type": "number" },
        "detalles": { "type": "array" },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "storeId", "nombre", "precio"]
    },
    "Order": {
      "title": "Order",
      "description": "Order placed by a customer in a store",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "storeId": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "buyerEmail": { "type": "string", "maxLength": 120 },
        "isClaimed": { "type": "boolean" },
        "customer": { "type": "object" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "totalAmount": { "type": "number" },
        "subtotal": { "type": "number" },
        "shippingCost": { "type": "number" },
        "shippingTracking": {
          "type": "object",
          "properties": {
            "carrier": { "type": "string" },
            "trackingCode": { "type": "string" },
            "shippedAt": { "type": "string" }
          }
        },
        "status": { "type": "string", "maxLength": 40 },
        "paymentStatus": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "storeId", "status"]
    },
    "AILog": {
      "title": "AILog",
      "description": "Log record of AI try-on executions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "storeId": { "type": "string", "maxLength": 64 },
        "model": { "type": "string", "maxLength": 80 },
        "status": { "type": "string", "maxLength": 40 },
        "timestamp": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "storeId", "status"]
    },
    "StoreOwner": {
      "title": "StoreOwner",
      "description": "Store owner administrator user authenticated via Firebase Auth",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 120 },
        "displayName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "maxLength": 40 },
        "storeId": { "type": "string", "maxLength": 64 },
        "subdomain": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["uid", "email", "role"]
    }
  },
  "firestore": {
    "/stores/{storeId}": {
      "schema": "Store",
      "description": "Multi-tenant stores collection"
    },
    "/stores/{storeId}/products/{productId}": {
      "schema": "Product",
      "description": "Store products subcollection dedicated to each client store"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Products catalog collection partitioned by storeId"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Store customer orders with CapFit ID association and shipping tracking"
    },
    "/users/{uid}": {
      "schema": "User",
      "description": "Global CapFit ID shopper and owner profile with fit measurements, selfies, and addresses"
    },
    "/store_customers/{relationId}": {
      "schema": "StoreCustomer",
      "description": "Per-store customer engagement relationship ({storeId}_{uid}) with wishlist and stats"
    },
    "/try_on_generations/{genId}": {
      "schema": "TryOnGeneration",
      "description": "History of virtual try-on generations"
    },
    "/ai_logs/{logId}": {
      "schema": "AILog",
      "description": "AI virtual try-on usage logs"
    },
    "/store_owners/{userId}": {
      "schema": "StoreOwner",
      "description": "Store owner profile and store association"
    }
  }
}
